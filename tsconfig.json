{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "allowJs": true,                  // Eski .js dosyalarının da çalışmasına izin verir
    "checkJs": false,                 // Eski .js dosyalarında katı hata denetimi yapmaz (bizi yormaz)
    "strict": true,                   // Yeni yazacağımız .ts dosyalarında tam güvenlik sağlar
    "noImplicitAny": false,           // "any" tipi için bizi çok sıkıştırmaz, esneklik tanır
    "esModuleInterop": true,          // require ve import sistemini birbiriyle uyumlu hale getirir
    "skipLibCheck": true,             // Kütüphanelerin içindeki hazır kodları denetlerken vakit kaybetmez
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*"],
  "exclude": ["node_modules"]
}